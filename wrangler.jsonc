{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-config",
  "main": "src/index.tsx",
  "compatibility_date": "2025-04-12",
  // 启用 kv_namespaces 配置，用于存储订阅信息
  "kv_namespaces": [
    {
      "binding": "CLASH_SUBS",
      "id": "替换为你在Cloudflare创建的KV命名空间ID"
    }
  ]
